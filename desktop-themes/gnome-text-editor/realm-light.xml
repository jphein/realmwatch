<?xml version="1.0" encoding="UTF-8"?>
<!--
  Realm Light — Enchanted Parchment
  Light grimoire theme for gnome-text-editor.
  Sunlit vellum with deep gem-tone syntax.
-->
<style-scheme id="realm-light" name="Realm Light" version="1.0">
  <author>JP</author>

  <metadata>
    <property name="variant">light</property>
    <property name="dark-variant">realm-dark</property>
  </metadata>

  <!-- Editor chrome -->
  <style name="text"                        foreground="#1a1028" background="#f5edd8"/>
  <style name="selection"                   background="rgba(212, 160, 80, 0.22)"/>
  <style name="search-match"                foreground="#f5edd8" background="#8a6520"/>
  <style name="cursor"                      foreground="#8a6520"/>
  <style name="current-line"                background="#ece3ce"/>
  <style name="current-line-number"         foreground="#8a6520" background="#ece3ce"/>
  <style name="line-numbers"                foreground="#a0907a" background="#f5edd8"/>
  <style name="draw-spaces"                 foreground="#ddd4c0"/>
  <style name="background-pattern"          background="#f0e6d0"/>
  <style name="bracket-match"               foreground="#8a6520" background="rgba(212, 160, 80, 0.25)" bold="true"/>
  <style name="bracket-mismatch"            foreground="#a83030" underline="error" bold="true"/>
  <style name="right-margin"                foreground="#ddd4c0" background="#ddd4c0"/>
  <style name="map-overlay"                 background="#ddd4c0"/>

  <!-- Syntax: dark gold for strings -->
  <style name="def:string"                  foreground="#8a6520"/>

  <!-- Syntax: deep amethyst for keywords/types -->
  <style name="def:keyword"                 foreground="#6a3a90" bold="true"/>
  <style name="def:type"                    foreground="#7a4aaa" bold="true"/>
  <style name="def:boolean"                 foreground="#6a3a90"/>

  <!-- Syntax: deep emerald for identifiers/variables -->
  <style name="def:identifier"              foreground="#287848"/>
  <style name="def:variable"                foreground="#1a6838"/>

  <!-- Syntax: warm brown for comments -->
  <style name="def:comment"                 foreground="#907a60" italic="true"/>

  <!-- Syntax: amber for numbers -->
  <style name="def:floating-point"          foreground="#9a7020"/>
  <style name="def:decimal"                 foreground="#9a7020"/>
  <style name="def:base-n-integer"          foreground="#9a7020"/>
  <style name="def:special-constant"        foreground="#8a6520" bold="true"/>

  <!-- Syntax: ruby for errors -->
  <style name="def:error"                   foreground="#a83030" bold="true"/>
  <style name="def:warning"                 foreground="#b84a30"/>
  <style name="def:note"                    foreground="#1a7868" bold="true"/>

  <!-- Syntax: deep teal for preprocessor -->
  <style name="def:preprocessor"            foreground="#1a7868"/>

  <!-- Headings and structure -->
  <style name="def:list-marker"             foreground="#8a6520" bold="true"/>
  <style name="def:heading"                 foreground="#6a3a90" bold="true"/>
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         italic="true" bold="true"/>

  <!-- Links: deep sapphire -->
  <style name="def:net-address"             foreground="#3a5a90"/>
  <style name="def:link-destination"        foreground="#3a5a90"/>
  <style name="def:link-text"               foreground="#2a4a80"/>

  <!-- GTK-doc -->
  <style name="gtk-doc:function-name"       foreground="#287848"/>
  <style name="gtk-doc:function"            foreground="#287848"/>
  <style name="gtk-doc:parameter"           foreground="#1a6838" bold="true"/>
  <style name="gtk-doc:constant"            foreground="#8a6520" bold="true"/>
  <style name="gtk-doc:type"                foreground="#7a4aaa" bold="true"/>
  <style name="gtk-doc:since"               bold="true"/>
  <style name="gtk-doc:return"              bold="true"/>
  <style name="gtk-doc:deprecated"          foreground="#a83030" bold="true"/>
  <style name="gtk-doc:signal-name"         foreground="#8a6520" bold="true"/>
  <style name="gtk-doc:property-name"       foreground="#8a6520" bold="true"/>

</style-scheme>
