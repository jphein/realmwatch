# ══════════════════════════════════════════════════════════════
#   REALM GHOSTTY LIGHT — Enchanted Parchment Terminal
#   Sunlit vellum palette inspired by realm.watch
# ══════════════════════════════════════════════════════════════

# ── Font ──
font-family = Ubuntu Sans Mono
font-size = 13
font-feature = -liga

# ── Window ──
background-opacity = 0.92
background-blur = 20
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend
confirm-close-surface = false
gtk-titlebar = true
window-decoration = server
window-theme = ghostty
window-subtitle = false
window-titlebar-background = #f0e6d0
window-titlebar-foreground = #6a4a10

# ── tmux integration — Ghostty launches tmux by default (see ~/Projects/tmux) ──
# These MUST live in this template: realm-theme-watcher regenerates
# ~/.config/ghostty/config on every login / theme switch, so anything hand-edited
# into the deployed file is silently overwritten. window-subtitle=false (above)
# hands the titlebar text to tmux (set-titles-string).
command = ~/Projects/tmux/ghostty-tmux
gtk-single-instance = false
gtk-custom-css = titlebar.css

# ── Colors: The Enchanted Parchment ──
foreground = #1a1028
background = #f5edd8
minimum-contrast = 1.2

# Cursor: dark gold quill
cursor-color = #8a6520
cursor-text = #f5edd8
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.9

# Selection: warm gold wash
selection-foreground = #1a1028
selection-background = #dcc898

# Search: sunlit highlight
search-foreground = #f5edd8
search-background = #8a6520
search-selected-foreground = #f5edd8
search-selected-background = #6a4a10

# ── ANSI: Sunlit Gem Palette ──
# Black (ink)
palette = 0=#2a2038
palette = 8=#5a4a68

# Red (deep ruby)
palette = 1=#a83030
palette = 9=#c84040

# Green (deep emerald)
palette = 2=#287848
palette = 10=#1a6838

# Yellow (dark gold)
palette = 3=#8a6520
palette = 11=#6a4a10

# Blue (deep sapphire)
palette = 4=#3a5a90
palette = 12=#2a4a80

# Magenta (deep amethyst)
palette = 5=#6a3a90
palette = 13=#7a4aaa

# Cyan (deep teal)
palette = 6=#1a7868
palette = 14=#288a78

# White (parchment)
palette = 7=#5a4a68
palette = 15=#1a1028

# ── Splits: sunlit dividers ──
split-divider-color = #8a6520
unfocused-split-opacity = 0.7
unfocused-split-fill = #f0e6d0

# ── Scrollback ──
scrollback-limit = 100000

# ── Bell — completely disabled ──
bell-features = no-audio
bell-features = no-attention
bell-features = no-title

# ── Performance (optimized for Claude Code) ──
# JP wants Ghostty doing NO automatic copying of any kind (2026-07-31).
# `clipboard` (the old value) wrote every selection to PRIMARY *and* the system
# CLIPBOARD, destroying whatever had been copied from another app. `false` means
# Ghostty writes to neither. Middle-click paste still works — Ghostty enables it
# regardless of this setting.
# NOTE: Ghostty is not the only thing that can auto-copy here. These windows run
# tmux (see `command` above), and tmux's own `set-clipboard on` + `mouse on`
# copies selections to the system clipboard over OSC 52. Check ~/.tmux.conf too.
copy-on-select = false
mouse-scroll-multiplier = 3
window-inherit-font-size = false
resize-overlay = never

# ── Keybindings ──
# Scrollback pager
keybind = ctrl+shift+h=write_screen_file:open,plain

keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+enter=new_split:right

# Font size
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# ── Shell Integration ──
shell-integration = detect

# -- No "Copied to clipboard" toast -----------------------------------------
# Ghostty's default is `app-notifications = clipboard-copy,config-reload`, so
# every OSC 52 clipboard write from an app inside the terminal raised a popup.
# Claude Code emits those on its copy actions, which is what JP kept seeing
# (2026-08-03). tmux now refuses to relay them (`set-clipboard off` in
# ~/Projects/tmux/tmux.conf) -- this is the second layer, so nothing can toast
# even if something writes the clipboard directly.
#
# JP's workflow is the native desktop one: drag to select (-> PRIMARY),
# middle-click to paste. Deliberate copies still work via Ctrl+Shift+C.
app-notifications = no-clipboard-copy
