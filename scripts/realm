#!/usr/bin/env bash
#
# realm — unified CLI dispatcher for realmwatch.
#
# Resolves `realm <sub> <args...>` by searching, in order:
#   1. $REALM_EXEC_PATH/realm-<sub>      (core subcommands)
#   2. <repo>/plugins/<sub>/cli          (plugin CLI handlers)
#   3. realm-<sub> on $PATH              (user-installed)
#
# If nothing matches, prints an error suggesting close matches.
#
# Special tokens handled by the dispatcher itself:
#   realm                       → command index (one line per subcommand)
#   realm -h | --help | help    → command index + global flags
#   realm --version             → sigil-format version line
#   realm --list-commands       → newline-separated subcommand names (for completion)
#   realm --list-fleet-names    → newline-separated fleet current_names (5s cached)
#   realm --list-plugin-names   → newline-separated plugin names (5s cached)
#   realm --list-fix-targets    → static list of `realm fix` targets
#   realm --list-wizard-sections → static list of `realm wizard --section` names
#   realm completion bash|zsh   → emits completion script
#
# Everything else is delegated.

set -euo pipefail

# Resolve our own location and the repo root
_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_scripts_dir="$(cd "$(dirname "$_self")" && pwd)"
_repo_dir="$(cd "$_scripts_dir/.." && pwd)"
_plugins_dir="$_repo_dir/plugins"

# Default exec path is <repo>/scripts/cli, overridable via REALM_EXEC_PATH
: "${REALM_EXEC_PATH:=$_scripts_dir/cli}"

# Source the shared lib for colors and helpers (so the dispatcher itself
# emits matching output). The lib's final line is a defensive
# `[[ -f fleet.sh ]] && source ...` which returns 1 when fleet.sh is
# absent (it's gitignored / JP-specific) — under `set -e` that propagates
# and kills the dispatcher silently. Wrap with `|| true` so a missing
# fleet.sh is non-fatal: the dispatcher itself doesn't need fleet helpers,
# only some subcommands do.
# shellcheck disable=SC1091
source "$_scripts_dir/lib/realm-cli.sh" || true

# Resolve a subcommand name to an executable path. Echos the path, returns 0
# on hit; returns 1 on miss.
realm::_resolve() {
  local sub="$1"
  local candidate

  # 1. core executable in REALM_EXEC_PATH
  for candidate in "$REALM_EXEC_PATH/realm-$sub" "$REALM_EXEC_PATH/realm-$sub.sh"; do
    if [[ -x "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done

  # 1b. existing top-level scripts/realm-*.sh (kept for backwards compat)
  for candidate in "$_scripts_dir/realm-$sub.sh" "$_scripts_dir/realm-$sub"; do
    if [[ -x "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done

  # 2. plugin-provided cli (Method A — executable file)
  if [[ -x "$_plugins_dir/$sub/cli" ]]; then
    printf '%s' "$_plugins_dir/$sub/cli"
    return 0
  fi

  # 2b. plugin with declarative cli section in plugin.json (Method B)
  if [[ -f "$_plugins_dir/$sub/plugin.json" ]]; then
    if jq -e '.cli.verbs and (.cli.verbs | length > 0)' "$_plugins_dir/$sub/plugin.json" >/dev/null 2>&1; then
      # Route through the generic plugin handler, passing the plugin name
      # via REALM_DELEGATE_PLUGIN so the exec wrapper can prepend it.
      printf 'REALM_DELEGATE_PLUGIN:%s' "$sub"
      return 0
    fi
  fi

  # 3. on $PATH
  if candidate="$(command -v "realm-$sub" 2>/dev/null)"; then
    printf '%s' "$candidate"
    return 0
  fi

  return 1
}

# Enumerate every available subcommand name. Used by the index and completion.
realm::_list_subcommands() {
  local seen=""
  local f sub

  # Core dir
  if [[ -d "$REALM_EXEC_PATH" ]]; then
    for f in "$REALM_EXEC_PATH"/realm-*; do
      [[ -x "$f" ]] || continue
      sub="$(basename "$f")"
      sub="${sub#realm-}"
      sub="${sub%.sh}"
      # Skip hidden / internal names
      [[ "$sub" == ".realm-version" ]] && continue
      [[ "$sub" == .* ]] && continue
      # Skip the generic plugin handler — it's an internal dispatch target,
      # not a user-facing subcommand. Users reach it via `realm <plugin>`.
      [[ "$sub" == "plugin" ]] && continue
      if [[ "$seen" != *"|$sub|"* ]]; then
        printf '%s\n' "$sub"
        seen="$seen|$sub|"
      fi
    done
  fi

  # Top-level realm-*.sh (existing scripts)
  for f in "$_scripts_dir"/realm-*.sh; do
    [[ -x "$f" ]] || continue
    sub="$(basename "$f")"
    sub="${sub#realm-}"
    sub="${sub%.sh}"
    [[ "$sub" == .* ]] && continue
    if [[ "$seen" != *"|$sub|"* ]]; then
      printf '%s\n' "$sub"
      seen="$seen|$sub|"
    fi
  done

  # Plugin-provided CLI hooks (Method A — executable)
  if [[ -d "$_plugins_dir" ]]; then
    for f in "$_plugins_dir"/*/cli; do
      [[ -x "$f" ]] || continue
      sub="$(basename "$(dirname "$f")")"
      if [[ "$seen" != *"|$sub|"* ]]; then
        printf '%s\n' "$sub"
        seen="$seen|$sub|"
      fi
    done
    # Method B — plugins with a `cli` section in plugin.json
    for f in "$_plugins_dir"/*/plugin.json; do
      [[ -f "$f" ]] || continue
      sub="$(basename "$(dirname "$f")")"
      [[ "$seen" == *"|$sub|"* ]] && continue
      if jq -e '.cli.verbs and (.cli.verbs | length > 0)' "$f" >/dev/null 2>&1; then
        printf '%s\n' "$sub"
        seen="$seen|$sub|"
      fi
    done
  fi
}

# Fallback summaries for legacy scripts that don't yet implement
# `--one-line-help`. As scripts get refactored, entries here can be deleted.
realm::_legacy_summary() {
  case "$1" in
    health)  echo "Check realm services, ports, DB, env" ;;
    update)  echo "Run plugin/system update flow" ;;
    *)       echo "" ;;
  esac
}

# Ask the subcommand for its one-line summary, with a short timeout and a
# legacy fallback. Discards any multi-line output (legacy scripts that
# misinterpret --one-line-help and run their main logic).
realm::_summary_for() {
  local sub="$1"
  local path="$2"
  local out

  # Plugin-declared (Method B) — pull the summary straight from plugin.json
  if [[ "$path" = "REALM_DELEGATE_PLUGIN:"* ]]; then
    local plugin="${path#REALM_DELEGATE_PLUGIN:}"
    out="$(jq -r '.cli.summary // .description // ""' "$_plugins_dir/$plugin/plugin.json" 2>/dev/null || true)"
    # Single-line, reasonable length
    if [[ -n "$out" ]] && [[ "$(printf '%s' "$out" | wc -l)" -le 1 ]] && [[ "${#out}" -lt 120 ]]; then
      printf '%s' "$out"
      return
    fi
    printf '%s' "(plugin)"
    return
  fi

  # 1s timeout so a slow / wrong script can't wedge the index
  out="$(timeout 1 "$path" --one-line-help 2>/dev/null || true)"
  # Single-line, reasonable length, not starting with whitespace garbage
  if [[ -n "$out" ]] && [[ "$(printf '%s' "$out" | wc -l)" -le 1 ]] && [[ "${#out}" -lt 120 ]]; then
    printf '%s' "$out"
    return
  fi
  printf '%s' "$(realm::_legacy_summary "$sub")"
}

# Print the command index (used when `realm` is called with no args or with
# `realm help` / `realm -h` / `realm --help`).
realm::_index() {
  printf '%srealm%s — unified CLI for realmwatch\n\n' "$W" "$N"
  printf '%sUSAGE%s\n' "$W" "$N"
  printf '  realm <command> [options] [args]\n  realm help <command>\n\n'

  printf '%sCOMMANDS%s\n' "$W" "$N"

  local sub path summary
  while IFS= read -r sub; do
    [[ -z "$sub" ]] && continue
    if path="$(realm::_resolve "$sub")"; then
      summary="$(realm::_summary_for "$sub" "$path")"
      printf '  %s%-18s%s %s\n' "$C" "$sub" "$N" "$summary"
    fi
  done < <(realm::_list_subcommands | sort -u)

  printf '\n%sGLOBAL FLAGS%s\n' "$W" "$N"
  printf '  %s-h, --help%s         Show this help (or per-command help)\n' "$C" "$N"
  printf '  %s    --version%s      Print version and exit\n' "$C" "$N"
  printf '  %s    --json%s         Machine-readable JSON output\n' "$C" "$N"
  printf '  %s    --no-color%s     Disable ANSI color\n' "$C" "$N"
  printf '  %s-v, --verbose%s      Verbose output (curl invocations, etc.)\n' "$C" "$N"
  printf '  %s-q, --quiet%s        Suppress informational output\n' "$C" "$N"
  printf '  %s    --dry-run%s      Preview HTTP calls without sending\n' "$C" "$N"
  printf '  %s    --host URL%s     Override $REALM_HOST (default: %s)\n' "$C" "$N" "$REALM_HOST"

  printf '\n%sENVIRONMENT%s\n' "$W" "$N"
  printf '  REALM_HOST          Base URL for the realm HTTP API (default http://localhost)\n'
  printf '  REALM_EXEC_PATH     Where to find core realm-* executables\n'
  printf '  NO_COLOR            If set, suppress ANSI color\n'

  printf '\n%sEXAMPLES%s\n' "$W" "$N"
  printf '  realm status\n  realm quest list\n  realm watch --filter discovery\n  realm discovery scan\n  realm fleet audit\n'
}

# Inline bash completion script. Used when realm-completion isn't installed.
# NOTE: `_realm_complete` is intentionally the first non-blank line of the
# emitted script so the CI smoke test
# (`scripts/realm completion bash | head -5 | grep _realm_complete`)
# always finds the function name in the first window.
realm::_emit_completion_bash() {
  cat <<'BASH'
_realm_complete() {
  # realm bash completion — generated by `realm completion bash`
  # Install with:
  #   realm completion bash > ~/.local/share/bash-completion/completions/realm
  #
  # Context-sensitive sources (all run silently, fall back to empty on error):
  #   realm show <TAB>             → fleet names
  #   realm ssh <TAB>              → fleet names
  #   realm fix <TAB>              → static remediation targets
  #   realm watch --node <TAB>     → fleet names
  #   realm wizard --section <TAB> → static wizard sections
  #   realm fleet rename <TAB>     → fleet names
  #   realm tail <TAB>             → plugin names
  # Live sources are cached in ~/.cache/realm/ for ~5s.

  local cur prev cword
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  cword=$COMP_CWORD

  if [[ $cword -eq 1 ]]; then
    local cmds
    cmds=$(realm --list-commands 2>/dev/null)
    COMPREPLY=( $(compgen -W "$cmds help --help --version --json --no-color --verbose --quiet --dry-run --host" -- "$cur") )
    return 0
  fi

  local sub="${COMP_WORDS[1]}"

  # ---- Context-sensitive completion (flag-driven) ----
  # These run BEFORE per-subcommand fallback so they fire on the immediate
  # arg-after-the-flag position, regardless of where the flag sits.
  case "$prev" in
    --node)
      # realm watch --node <TAB>  (and any other subcommand that gains --node)
      local names
      names=$(realm --list-fleet-names 2>/dev/null) || names=""
      COMPREPLY=( $(compgen -W "$names" -- "$cur") )
      return 0
      ;;
    --section)
      # realm wizard --section <TAB>
      local sections
      sections=$(realm --list-wizard-sections 2>/dev/null) || sections=""
      COMPREPLY=( $(compgen -W "$sections" -- "$cur") )
      return 0
      ;;
  esac

  # ---- Context-sensitive completion (subcommand-positional) ----
  case "$sub" in
    show|ssh)
      # `realm show <name>` or `realm ssh <host>` — fleet name at position 2.
      if [[ $cword -eq 2 ]]; then
        local names
        names=$(realm --list-fleet-names 2>/dev/null) || names=""
        COMPREPLY=( $(compgen -W "$names" -- "$cur") )
        return 0
      fi
      ;;
    fix)
      # `realm fix <target>` — static target list at position 2.
      if [[ $cword -eq 2 ]]; then
        local targets
        targets=$(realm --list-fix-targets 2>/dev/null) || targets=""
        COMPREPLY=( $(compgen -W "$targets" -- "$cur") )
        return 0
      fi
      ;;
    tail)
      # `realm tail <plugin>` — plugin name at position 2.
      if [[ $cword -eq 2 ]]; then
        local plugins
        plugins=$(realm --list-plugin-names 2>/dev/null) || plugins=""
        COMPREPLY=( $(compgen -W "$plugins" -- "$cur") )
        return 0
      fi
      ;;
    fleet)
      # `realm fleet rename <TAB>` → fleet names at position 3
      if [[ $cword -eq 3 ]] && [[ "${COMP_WORDS[2]}" == "rename" ]]; then
        local names
        names=$(realm --list-fleet-names 2>/dev/null) || names=""
        COMPREPLY=( $(compgen -W "$names" -- "$cur") )
        return 0
      fi
      ;;
  esac

  # Per-subcommand completion: ask the dispatcher to delegate to the
  # subcommand's --list-subcommands. Works for both Method-A executables and
  # Method-B declarative plugins (the dispatcher routes both through the
  # same hook).
  local subs
  subs=$(realm "$sub" --list-subcommands 2>/dev/null) || subs=""
  if [[ -n "$subs" ]]; then
    COMPREPLY=( $(compgen -W "$subs --help --json --no-color --verbose --quiet --dry-run --host" -- "$cur") )
    return 0
  fi

  COMPREPLY=( $(compgen -W "--help --json --no-color --verbose --quiet --dry-run --host" -- "$cur") )
}

complete -F _realm_complete realm
BASH
}

realm::_emit_completion_zsh() {
  cat <<'ZSH'
#compdef realm
# realm zsh completion — generated by `realm completion zsh`
# Install with:
#   realm completion zsh > ~/.local/share/zsh/site-functions/_realm
#
# Context-sensitive sources (silent on failure, cached ~5s):
#   realm show <TAB>              → fleet names
#   realm ssh  <TAB>              → fleet names
#   realm fix  <TAB>              → static remediation targets
#   realm watch --node <TAB>      → fleet names
#   realm wizard --section <TAB>  → static wizard sections
#   realm fleet rename <TAB>      → fleet names
#   realm tail <TAB>              → plugin names

_realm() {
  local -a cmds
  local prev="${words[CURRENT-1]}"
  local sub="${words[2]:-}"

  # ---- Flag-driven context completion ----
  case "$prev" in
    --node)
      local -a fleet
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        fleet+=("$line")
      done < <(realm --list-fleet-names 2>/dev/null)
      (( ${#fleet[@]} > 0 )) && _describe -t fleet 'fleet name' fleet
      return
      ;;
    --section)
      local -a sections
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        sections+=("$line")
      done < <(realm --list-wizard-sections 2>/dev/null)
      (( ${#sections[@]} > 0 )) && _describe -t sections 'wizard section' sections
      return
      ;;
  esac

  # ---- Position 1: top-level subcommand ----
  if (( CURRENT == 2 )); then
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local help_line
      help_line="$(realm-$line --one-line-help 2>/dev/null || echo '')"
      cmds+=("$line:$help_line")
    done < <(realm --list-commands 2>/dev/null)
    _describe -t commands 'realm commands' cmds
    return
  fi

  # ---- Position 2: subcommand-specific positional completion ----
  if (( CURRENT == 3 )); then
    case "$sub" in
      show|ssh)
        local -a fleet
        while IFS= read -r line; do
          [[ -z "$line" ]] && continue
          fleet+=("$line")
        done < <(realm --list-fleet-names 2>/dev/null)
        (( ${#fleet[@]} > 0 )) && _describe -t fleet 'fleet name' fleet
        return
        ;;
      fix)
        local -a targets
        while IFS= read -r line; do
          [[ -z "$line" ]] && continue
          targets+=("$line")
        done < <(realm --list-fix-targets 2>/dev/null)
        (( ${#targets[@]} > 0 )) && _describe -t targets 'fix target' targets
        return
        ;;
      tail)
        local -a plugins
        while IFS= read -r line; do
          [[ -z "$line" ]] && continue
          plugins+=("$line")
        done < <(realm --list-plugin-names 2>/dev/null)
        (( ${#plugins[@]} > 0 )) && _describe -t plugins 'plugin name' plugins
        return
        ;;
    esac
  fi

  # ---- Position 3: `realm fleet rename <name>` ----
  if (( CURRENT == 4 )) && [[ "$sub" == "fleet" ]] && [[ "${words[3]}" == "rename" ]]; then
    local -a fleet
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      fleet+=("$line")
    done < <(realm --list-fleet-names 2>/dev/null)
    (( ${#fleet[@]} > 0 )) && _describe -t fleet 'fleet name' fleet
    return
  fi

  # ---- Default: per-subcommand --list-subcommands ----
  local -a subs
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    subs+=("$line")
  done < <(realm "$sub" --list-subcommands 2>/dev/null)
  if (( ${#subs[@]} > 0 )); then
    _describe -t subcommands "$sub subcommands" subs
  fi
}

_realm "$@"
ZSH
}

# ------------- completion helpers -------------
#
# Short-lived caches for completion sources that hit the live HTTP API.
# Live data (fleet names, loaded plugins) is cached for ~5s so freshly
# added hosts and plugins show up quickly without hammering the server on
# every TAB. Static lists (fix targets, wizard sections) are not cached —
# they're trivial to emit.

# Resolve the cache directory in a sudo-aware way (per .gemini/styleguide.md:
# "sudo-aware home resolution everywhere"). The wizard runs as JP normally,
# but the dispatcher can be invoked from a hook or systemd unit under sudo,
# where $HOME would point at /root and silently fragment the cache. Prefer
# realm_text.real_home() (resolves SUDO_USER's real home); fall back to
# $XDG_CACHE_HOME / $HOME only if python or realm_text aren't available.
realm::_resolve_cache_dir() {
  local override="${REALM_CACHE_DIR:-}"
  if [[ -n "$override" ]]; then
    printf '%s' "$override"
    return 0
  fi
  local py="$_repo_dir/.venv/bin/python3"
  [[ -x "$py" ]] || py="python3"
  local resolved
  resolved="$(PYTHONPATH="$_repo_dir${PYTHONPATH:+:$PYTHONPATH}" \
      "$py" -c "from realm_text import real_home; print(real_home() / '.cache/realm')" \
      2>/dev/null)" || resolved=""
  if [[ -n "$resolved" ]]; then
    printf '%s' "$resolved"
    return 0
  fi
  # Final fallback — honor XDG_CACHE_HOME first, then $HOME. This is the
  # pre-fix behavior; only reached when realm_text is unavailable.
  printf '%s' "${XDG_CACHE_HOME:-$HOME/.cache}/realm"
}

REALM_COMPLETION_CACHE_DIR="$(realm::_resolve_cache_dir)"
REALM_COMPLETION_CACHE_TTL="${REALM_COMPLETION_CACHE_TTL:-5}"

realm::_cache_ok() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  [[ -r "$file" ]] || return 1
  local now mtime age
  now=$(date +%s 2>/dev/null) || return 1
  mtime=$(stat -c '%Y' "$file" 2>/dev/null || stat -f '%m' "$file" 2>/dev/null) || return 1
  age=$(( now - mtime ))
  # Sanitize TTL: default to 5 if unset or non-numeric — avoids arithmetic
  # errors to stderr (which would break the "silent on failure" contract
  # under set -euo pipefail).
  local ttl="${REALM_COMPLETION_CACHE_TTL:-5}"
  [[ "$ttl" =~ ^[0-9]+$ ]] || ttl=5
  # Use [[ -lt ]] (not (( )) ) so a false result returns "no" without
  # tripping set -e — arithmetic eval returns exit code 1 when the value
  # is 0, which would terminate callers under set -euo pipefail.
  [[ $age -lt $ttl ]]
}

realm::_cache_write() {
  local file="$1"
  mkdir -p "$(dirname "$file")" 2>/dev/null || return 1
  cat > "$file" 2>/dev/null || return 1
}

# realm::_emit_fleet_names — newline-separated current_names from /fleet/list.
# Falls back silently to an empty list if the server is unreachable. Caches
# the result for REALM_COMPLETION_CACHE_TTL seconds.
realm::_emit_fleet_names() {
  local cache="$REALM_COMPLETION_CACHE_DIR/fleet-names"
  if realm::_cache_ok "$cache"; then
    cat "$cache"
    return 0
  fi
  mkdir -p "$REALM_COMPLETION_CACHE_DIR" 2>/dev/null || true
  local out names=""
  if out=$(curl --silent --fail --max-time 2 \
      "${REALM_API}/fleet/list" 2>/dev/null); then
    names=$(printf '%s' "$out" | jq -r '.entries[]?.current_name // empty' 2>/dev/null) || names=""
  fi
  # Always write the cache file (even if empty) so negative results are
  # also throttled for the TTL window — repeated TAB presses with the
  # server down shouldn't keep re-hitting the API.
  printf '%s' "$names" > "$cache" 2>/dev/null || true
  [[ -n "$names" ]] && printf '%s\n' "$names"
  return 0
}

# realm::_emit_plugin_names — newline-separated plugin names from /plugins.
# Falls back to a filesystem scan of plugins/ if the server is unreachable.
realm::_emit_plugin_names() {
  local cache="$REALM_COMPLETION_CACHE_DIR/plugin-names"
  if realm::_cache_ok "$cache"; then
    cat "$cache"
    return 0
  fi
  mkdir -p "$REALM_COMPLETION_CACHE_DIR" 2>/dev/null || true
  local names="" out
  if out=$(curl --silent --fail --max-time 2 \
      "${REALM_API}/plugins" 2>/dev/null); then
    names=$(printf '%s' "$out" | jq -r '.[]?.name // empty' 2>/dev/null) || names=""
  fi
  # Fallback: scan plugins/ directory directly. Survives server-down.
  if [[ -z "$names" && -d "$_plugins_dir" ]]; then
    local d entry_name
    for d in "$_plugins_dir"/*/plugin.json; do
      [[ -f "$d" ]] || continue
      entry_name="$(basename "$(dirname "$d")")"
      if [[ -z "$names" ]]; then
        names="$entry_name"
      else
        names+=$'\n'"$entry_name"
      fi
    done
  fi
  # Always write the cache (even if empty) so the TTL also throttles
  # negative results when the server is down and plugins/ is missing.
  printf '%s' "$names" > "$cache" 2>/dev/null || true
  [[ -n "$names" ]] && printf '%s\n' "$names"
  return 0
}

# realm::_emit_fix_targets — static list, kept in sync with realm-fix.sh.
realm::_emit_fix_targets() {
  cat <<'EOF'
dnsmasq
fleet-yaml
server-restart
hot-rebuild
permissions
cleanup
EOF
}

# realm::_emit_wizard_sections — static list, kept in sync with the wizard
# design doc (and realm-wizard.sh when it lands).
realm::_emit_wizard_sections() {
  cat <<'EOF'
prereqs
realm-setup
terminal
local-llms
cloud-keys
commercial-cli
oss-agents
mcp-wire
EOF
}

# ------------- main -------------

# Special handling that must happen before delegation
case "${1:-}" in
  ""|help|-h|--help)
    realm::_index
    exit 0
    ;;
  --version)
    realm::_print_version
    exit 0
    ;;
  --list-commands)
    realm::_list_subcommands | sort -u
    exit 0
    ;;
  --list-fleet-names)
    realm::_emit_fleet_names
    exit 0
    ;;
  --list-plugin-names)
    realm::_emit_plugin_names
    exit 0
    ;;
  --list-fix-targets)
    realm::_emit_fix_targets
    exit 0
    ;;
  --list-wizard-sections)
    realm::_emit_wizard_sections
    exit 0
    ;;
  completion)
    shift
    case "${1:-bash}" in
      bash) realm::_emit_completion_bash ;;
      zsh)  realm::_emit_completion_zsh ;;
      *)    realm::die "unknown shell: $1 (try: bash, zsh)" 2 ;;
    esac
    exit 0
    ;;
esac

sub="$1"; shift

# Helper: exec the resolved command. Handles the "REALM_DELEGATE_PLUGIN:<name>"
# sentinel by routing through scripts/cli/realm-plugin.sh with the plugin name
# as the first arg.
realm::_exec_resolved() {
  local resolved="$1"; shift
  if [[ "$resolved" = "REALM_DELEGATE_PLUGIN:"* ]]; then
    local plugin="${resolved#REALM_DELEGATE_PLUGIN:}"
    local handler="$REALM_EXEC_PATH/realm-plugin.sh"
    [[ -x "$handler" ]] || handler="$REALM_EXEC_PATH/realm-plugin"
    if [[ ! -x "$handler" ]]; then
      realm::die "plugin '$plugin' declares cli but realm-plugin handler is missing" 4
    fi
    exec "$handler" "$plugin" "$@"
  fi
  exec "$resolved" "$@"
}

# `realm help <sub>` — delegate to the subcommand's --help
if [[ "$sub" = "help" ]]; then
  if [[ $# -eq 0 ]]; then
    realm::_index
    exit 0
  fi
  sub="$1"; shift
  if path="$(realm::_resolve "$sub")"; then
    realm::_exec_resolved "$path" --help
  fi
  realm::die "no such command: $sub" 127
fi

if path="$(realm::_resolve "$sub")"; then
  realm::_exec_resolved "$path" "$@"
fi

# Suggest closest match (best-effort; never fail the dispatcher if grep finds nothing)
suggestion="$(realm::_list_subcommands 2>/dev/null | sort -u | grep -i "^${sub:0:2}" 2>/dev/null | head -3 | tr '\n' ' ' || true)"
if [[ -n "$suggestion" ]]; then
  printf '%s✘ realm:%s no such command: %s%s%s\n  did you mean: %s%s%s\n' \
    "$R" "$N" "$C" "$sub" "$N" "$Y" "$suggestion" "$N" >&2
else
  printf '%s✘ realm:%s no such command: %s%s%s\n  try: %srealm%s for the index\n' \
    "$R" "$N" "$C" "$sub" "$N" "$C" "$N" >&2
fi
exit 127
