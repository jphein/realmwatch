# ============================================================================
# Realmwatch — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# map_server.py auto-loads .env on startup.
#
# Lines starting with # are comments. Blank lines are ignored.
# Format: KEY=value (no quotes needed, no spaces around =)
# ============================================================================

# ── Home Assistant ──────────────────────────────────────────────────────────
# Used by: ha_bridge.py, map_server.py
# The HA bridge polls entity states and device registry to enrich node data.

# REQUIRED — Long-lived access token from Home Assistant
# Generate at: http://<your-ha-instance>/profile/security → Long-Lived Access Tokens
HA_TOKEN=your-home-assistant-long-lived-access-token

# OPTIONAL — Home Assistant base URL (default: https://10.0.6.108:8123)
# HA_URL=https://10.0.6.108:8123

# ── Notion ──────────────────────────────────────────────────────────────────
# Used by: notion_sync.py, codex_sync.py, engine.py
# Notion integration syncs todos as quest events and lore as codex entries.

# REQUIRED for quest sync — Notion internal integration token
# Create at: https://www.notion.so/my-integrations
# Either NOTION_TOKEN or NOTION_API_KEY will work (code checks both).
NOTION_TOKEN=your-notion-integration-token

# OPTIONAL — Alias for NOTION_TOKEN (checked as fallback)
# NOTION_API_KEY=your-notion-integration-token

# REQUIRED for quest sync — Notion database ID for the quest/todo database
# Found in the Notion database URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=your-notion-database-id

# ── Azure AI (Oracle + Chat) ───────────────────────────────────────────────
# Used by: chat_bridge.py
# Also used by oracle_daemon.py via ~/.config/azure-chat-assistant/config.json
# The chat bridge and oracle use Azure OpenAI for AI-powered responses.

# REQUIRED for chat — Azure AI API key
# Falls back to ~/.config/azure-chat-assistant/config.json "api_key" field
AZURE_AI_API_KEY=your-azure-ai-api-key

# REQUIRED for chat — Azure AI endpoint URL
# Falls back to ~/.config/azure-chat-assistant/config.json "endpoint" field
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com

# ── Azure Speech (TTS) ─────────────────────────────────────────────────────
# Used by: oracle_daemon.py (TTS announcements)
# Falls back to ~/.config/speech-to-cli/config.json fields.

# OPTIONAL — Azure Speech Services key (for oracle voice output)
# AZURE_SPEECH_KEY=your-azure-speech-key

# OPTIONAL — Azure Speech Services region (e.g. eastus, westus2)
# AZURE_SPEECH_REGION=eastus

# ── Network Addresses ──────────────────────────────────────────────────────
# Used by: engine.py
# Override default IPs for core infrastructure nodes.

# OPTIONAL — IP of the machine running Realmwatch (default: 10.0.6.129)
# KATANA_IP=10.0.6.129

# OPTIONAL — IP of the OpenWrt gateway/router (default: 10.0.6.1)
# ROUTER_IP=10.0.6.1

# OPTIONAL — IP of the UBox device (default: 10.0.6.11)
# UBOX_IP=10.0.6.11
