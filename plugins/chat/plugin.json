{
  "name": "chat",
  "version": "1.0.0",
  "type": "integrated",
  "description": "Azure AI chat integration — session-based chat with o4-mini, context-aware node discussions.",
  "fantasy_name": "Oracle Link",
  "icon": "\ud83d\udcac",

  "python": {
    "module": "plugin",
    "entry": "setup"
  },

  "endpoints": [
    {
      "method": "POST",
      "path": "/chat",
      "handler": "handle_chat",
      "raw_path": true
    },
    {
      "method": "POST",
      "path": "/chat/clear",
      "handler": "handle_chat_clear",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/chat/sessions",
      "handler": "handle_sessions",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/chat/history",
      "handler": "handle_history",
      "raw_path": true
    }
  ],

  "cli": {
    "summary": "Chat with the realm via Azure AI (o4-mini, session-aware)",
    "verbs": [
      {
        "name": "ask",
        "summary": "Send a single message and print the reply",
        "method": "POST",
        "path": "/chat",
        "args": ["message"],
        "body": "{\"message\":\"$1\"}"
      },
      {
        "name": "sessions",
        "summary": "List active chat sessions",
        "method": "GET",
        "path": "/chat/sessions",
        "table": ".sessions // [] | .[] | [.id // \"-\", .name // \"-\", (.messages // 0 | tostring), (.updated // \"-\")]",
        "header": ["ID", "NAME", "MESSAGES", "UPDATED"]
      },
      {
        "name": "history",
        "summary": "Show recent chat history",
        "method": "GET",
        "path": "/chat/history"
      },
      {
        "name": "clear",
        "summary": "Clear the current chat session",
        "method": "POST",
        "path": "/chat/clear"
      }
    ]
  }
}
