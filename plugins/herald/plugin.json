{
  "name": "herald",
  "version": "1.0.0",
  "type": "integrated",
  "description": "Herald daemon manager — starts/stops the realm herald subprocess that generates themed node speech events.",
  "fantasy_name": "Town Crier",
  "icon": "\ud83d\udcef",

  "python": {
    "module": "plugin",
    "entry": "setup"
  },

  "endpoints": [
    {
      "method": "GET",
      "path": "/herald",
      "handler": "handle_herald",
      "raw_path": true
    }
  ],

  "cli": {
    "summary": "Inspect the herald (voice daemon) status",
    "verbs": [
      {
        "name": "status",
        "summary": "Show herald daemon status",
        "method": "GET",
        "path": "/herald"
      }
    ]
  },

  "wave": {
    "verb": "herald",
    "title": "Town Crier",
    "summary": "Herald daemon liveness — speech events and last-call",
    "cmd": "realm herald status",
    "mode": "custom",
    "interval": 30
  }
}
