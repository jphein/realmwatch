{
  "name": "collectd",
  "version": "1.0.0",
  "type": "integrated",
  "description": "Collectd RRD reader + live UDP listener + Realm Census panel. Provides per-host metric summaries and a grouped node list.",
  "fantasy_name": "Scrying Stones",
  "icon": "\ud83d\udcca",

  "python": {
    "module": "plugin",
    "entry": "setup"
  },

  "panel": {
    "id": "node-list-panel",
    "name": "Realm Census",
    "html": "panel.html",
    "js": "panel.js",
    "css": "panel.css",
    "anchor": "e",
    "priority": 14
  },

  "endpoints": [
    {
      "method": "GET",
      "path": "/collectd",
      "handler": "handle_collectd",
      "raw_path": true
    }
  ],

  "sse_types": [],

  "config": {
    "rrd_path": {
      "type": "string",
      "default": "/var/lib/collectd/rrd/",
      "description": "Path to collectd RRD data directory"
    },
    "udp_port": {
      "type": "integer",
      "default": 25826,
      "description": "UDP port for collectd network protocol listener"
    }
  }
}
