{
  "name": "system-updates",
  "version": "1.2.0",
  "type": "integrated",
  "description": "Desktop package update tracker and runner — APT, Snap, Flatpak, mise, brew, and more.",
  "fantasy_name": "Scroll of Patch Runes",
  "icon": "📜",

  "python": {
    "module": "plugin",
    "entry": "setup"
  },

  "panel": {
    "id": "updates-panel",
    "name": "Scroll of Patch Runes",
    "html": "panel.html",
    "js": "panel.js",
    "css": "panel.css",
    "anchor": "ne",
    "priority": 15
  },

  "endpoints": [
    { "method": "GET",  "path": "/updates",              "handler": "handle_get_updates",  "raw_path": true },
    { "method": "GET",  "path": "/api/inventory",        "handler": "handle_get_inventory","raw_path": true },
    { "method": "GET",  "path": "/updates/history",      "handler": "handle_get_history",  "raw_path": true },
    { "method": "POST", "path": "/updates/check",        "handler": "handle_check_all",    "raw_path": true },
    { "method": "POST", "path": "/updates/check/<source>","handler": "handle_check_one",   "raw_path": true },
    { "method": "POST", "path": "/updates/run",           "handler": "handle_run_all",     "raw_path": true },
    { "method": "POST", "path": "/updates/run/<source>",  "handler": "handle_run_one",     "raw_path": true },
    { "method": "DELETE","path": "/updates/run/<source>",  "handler": "handle_cancel_one",  "raw_path": true },
    { "method": "POST",  "path": "/updates/approve/<source>", "handler": "handle_approve_one", "raw_path": true },
    { "method": "DELETE","path": "/updates/approve/<source>", "handler": "handle_skip_one",    "raw_path": true }
  ],

  "sse_types": ["updates"],

  "cli": {
    "summary": "Track and run desktop package updates (apt, snap, flatpak, mise, brew, ...)",
    "verbs": [
      {
        "name": "list",
        "summary": "List all known update sources and their pending updates",
        "method": "GET",
        "path": "/updates",
        "table": ".sources | to_entries[] | [.key, (.value.available // 0 | tostring), (.value.status // \"-\"), (.value.last_check // 0 | if . == 0 then \"never\" else (. | strftime(\"%Y-%m-%d %H:%M\")) end)]",
        "header": ["SOURCE", "PENDING", "STATUS", "LAST_CHECK"]
      },
      {
        "name": "inventory",
        "summary": "Show full inventory of installed packages across sources",
        "method": "GET",
        "path": "/api/inventory"
      },
      {
        "name": "history",
        "summary": "Show recent update runs",
        "method": "GET",
        "path": "/updates/history",
        "table": "(.history // [])[] | [.ts // \"-\", .source // \"-\", .action // \"-\", (.result // \"-\")]",
        "header": ["TIME", "SOURCE", "ACTION", "RESULT"]
      },
      {
        "name": "check",
        "summary": "Trigger an update check (all sources, or one if --source given)",
        "method": "POST",
        "path": "/updates/check"
      },
      {
        "name": "check-one",
        "summary": "Trigger an update check for one source",
        "method": "POST",
        "path": "/updates/check/<source>",
        "args": ["source"]
      },
      {
        "name": "run",
        "summary": "Run all approved updates",
        "method": "POST",
        "path": "/updates/run"
      },
      {
        "name": "run-one",
        "summary": "Run updates for one source",
        "method": "POST",
        "path": "/updates/run/<source>",
        "args": ["source"]
      },
      {
        "name": "cancel",
        "summary": "Cancel an in-flight update run for one source",
        "method": "DELETE",
        "path": "/updates/run/<source>",
        "args": ["source"]
      },
      {
        "name": "approve",
        "summary": "Approve pending updates for one source so the next run picks them up",
        "method": "POST",
        "path": "/updates/approve/<source>",
        "args": ["source"]
      },
      {
        "name": "skip",
        "summary": "Skip pending updates for one source",
        "method": "DELETE",
        "path": "/updates/approve/<source>",
        "args": ["source"]
      }
    ]
  },

  "wave": {
    "verb": "updates",
    "title": "Patch Runes",
    "summary": "Pending updates by source — apt, snap, flatpak, mise, brew",
    "cmd": "realm system-updates list",
    "mode": "custom",
    "interval": 120
  }
}
