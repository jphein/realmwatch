{
  "name": "system-updates",
  "version": "1.0.0",
  "type": "integrated",
  "description": "Desktop package update tracker and runner — APT, Snap, Flatpak, mise, brew, and more.",
  "fantasy_name": "Scroll of Patch Runes",
  "icon": "📜",

  "python": {
    "module": "plugin",
    "entry": "setup"
  },

  "panel": {
    "id": "updates-panel",
    "name": "Scroll of Patch Runes",
    "html": "panel.html",
    "js": "panel.js",
    "css": "panel.css",
    "anchor": "ne",
    "priority": 15
  },

  "endpoints": [
    { "method": "GET",  "path": "/updates",              "handler": "handle_get_updates",  "raw_path": true },
    { "method": "POST", "path": "/updates/check",        "handler": "handle_check_all",    "raw_path": true },
    { "method": "POST", "path": "/updates/check/<source>","handler": "handle_check_one",   "raw_path": true },
    { "method": "POST", "path": "/updates/run",           "handler": "handle_run_all",     "raw_path": true },
    { "method": "POST", "path": "/updates/run/<source>",  "handler": "handle_run_one",     "raw_path": true },
    { "method": "DELETE","path": "/updates/run/<source>",  "handler": "handle_cancel_one",  "raw_path": true }
  ],

  "sse_types": ["updates"]
}
