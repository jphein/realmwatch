# Realmwatch System Updates plugin — passwordless sudo for update commands
# Install: sudo cp this-file /etc/sudoers.d/realmwatch-updates && sudo chmod 440 /etc/sudoers.d/realmwatch-updates

jp ALL=(root) NOPASSWD: /usr/bin/apt update
jp ALL=(root) NOPASSWD: /usr/bin/apt upgrade -y
jp ALL=(root) NOPASSWD: /usr/bin/apt autoremove -y
jp ALL=(root) NOPASSWD: /usr/bin/snap refresh
jp ALL=(root) NOPASSWD: /usr/bin/snap refresh --list
jp ALL=(root) NOPASSWD: /usr/bin/fwupdmgr refresh --force
jp ALL=(root) NOPASSWD: /usr/bin/fwupdmgr get-updates
jp ALL=(root) NOPASSWD: /usr/bin/fwupdmgr update --no-reboot-check
