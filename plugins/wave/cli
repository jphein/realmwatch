#!/usr/bin/env bash
# realm wave — Wave Terminal block helpers.
# This file is invoked as `realm wave <verb> [args...]` via the realm
# dispatcher's plugin Method-A path (plugins/wave/cli, executable).
set -euo pipefail

REALM_HELP_SUMMARY="Wave Terminal blocks — adaptive monitor TUIs for the realm"

_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}")"
_plugin_dir="$(cd "$(dirname "$_self")" && pwd)"
_repo_dir="$(cd "$_plugin_dir/../.." && pwd)"

# Pick a python — repo .venv first (matches scripts/realm), fallback to system.
if [[ -x "$_repo_dir/.venv/bin/python3" ]]; then
    PY="$_repo_dir/.venv/bin/python3"
else
    PY="$(command -v python3)"
fi

# Map verb name → script. Hardcoded entries are baked-in launchers; the
# `wave` blocks in other plugins' plugin.json are merged in below via
# blocks/discover.py — they don't need a launcher file, they exec
# wave-block.py directly through cmd_run_manifest.
declare -A TUIS=(
    [bandwidth]="$_plugin_dir/blocks/bandwidth-launcher.py"
    [palace]="$_plugin_dir/blocks/palace-launcher.py"
    [daemon]="$_plugin_dir/blocks/daemon-launcher.py"
    [backfill]="$_plugin_dir/blocks/backfill-launcher.py"
    [sysmon]="$_plugin_dir/blocks/sysmon-launcher.py"
    [kgops]="$_plugin_dir/blocks/kgops-launcher.py"
    [benchmark]="$_plugin_dir/blocks/benchmark-launcher.py"
)

declare -A TITLES=(
    [bandwidth]="WAN bandwidth (gatekeeper br-lan.38)"
    [palace]="mempalace status"
    [daemon]="daemon journal (familiar)"
    [backfill]="KG extract backfill (familiar)"
    [sysmon]="sysmon (familiar)"
    [kgops]="KG ops (familiar)"
    [benchmark]="SME benchmark slate"
)

declare -A SUMMARIES=(
    [bandwidth]="Live WAN bandwidth (gatekeeper br-lan.38) — gold-bar + teal sparklines"
    [palace]="palace-daemon + mempalace_status: drawers/wings/triples + daemon ms"
    [daemon]="palace-daemon log health: error/warn counts in last 60s + last line"
    [backfill]="KG-extract queue progress + ETA via wave-block render_backfill"
    [sysmon]="familiar host metrics — load, RAM, disk, GPU temps, pg conns"
    [kgops]="familiar sysmon + KG queue counts + per-worker activity"
    [benchmark]="SME memory-system benchmark slate + live progress (status sigils + metric chips)"
)

# Manifest-discovered verbs: verb → "mode\tinterval\tcmd" so cmd_run_manifest
# can hand them off to wave-block.py without a per-verb launcher file.
declare -A MANIFESTS=()

# Pull `wave` blocks from every plugin's plugin.json and merge into the
# verb tables. Hardcoded entries take precedence on conflict (back-compat).
while IFS=$'\t' read -r m_verb m_title m_summary m_mode m_interval m_cmd; do
    [[ -z "$m_verb" ]] && continue
    if [[ -n "${TUIS[$m_verb]:-}" ]]; then
        echo "realm wave: manifest verb '$m_verb' collides with hardcoded launcher — keeping hardcoded" >&2
        continue
    fi
    TITLES[$m_verb]="$m_title"
    SUMMARIES[$m_verb]="$m_summary"
    MANIFESTS[$m_verb]=$'\x1f'"$m_mode"$'\x1f'"$m_interval"$'\x1f'"$m_cmd"
done < <("$PY" "$_plugin_dir/blocks/discover.py" 2>/dev/null)

usage() {
    cat <<EOF
realm wave — Wave Terminal blocks · adaptive monitor TUIs

USAGE
  realm wave <verb> [args...]

VERBS
  Hardcoded (all wave-block launchers — gold-bar + teal sparkline template):
    bandwidth                  Live WAN bandwidth (gatekeeper br-lan.38)
    palace                     mempalace_status — drawers/wings/triples
    daemon                     palace-daemon log-health snapshot
    backfill                   KG-extract queue progress + ETA
    sysmon                     familiar host metrics (load, RAM, GPU, pg)
    kgops                      sysmon + KG queue + per-worker activity
    benchmark                  SME benchmark slate + live progress

  Manifest-discovered (any plugin can add one — see "MANIFESTS" below):
    Run \`realm wave list\` for the live verb roster.

  Per-host dashboard (any fleet entry):
    realm wave <hostname>      GPU/CPU/RAM/disk/temps/net for that host.
                               Resolves <hostname> via \`realm --list-fleet-names\`
                               (Ubuntu hosts; OpenWrt nodes surface an error
                               for now — see issue #49 for the routing fix).

  Built-in:
    list                       List every available TUI (hardcoded + discovered)
    install [name]             Spawn the TUI(s) as Wave blocks via wsh
                               (no name → spawn all)

MANIFESTS
  A plugin can declare a wave TUI by adding a "wave" block to its
  plugin.json. blocks/discover.py picks them up at startup; no launcher
  file required. Minimum shape:

    "wave": {
      "verb":     "<name>",
      "title":    "<window title>",
      "summary":  "<one-line summary for \`realm wave list\`>",
      "cmd":      "<shell cmd emitting JSON>",
      "mode":     "custom",          // or "backfill"
      "interval": 30                  // poll seconds
    }

ENVIRONMENT (hardcoded verbs)
  PALACE_DAEMON_URL            Default http://familiar:8085
  PALACE_API_KEY               Required for palace TUI; auto-fetched from
                               familiar (~/.config/palace-daemon/env) if unset
  PALACE_DAEMON_HOST           Default jp@familiar (used by daemon TUI)
  PALACE_DAEMON_UNIT           Default palace-daemon (used by daemon TUI)
  KG_EXTRACT_TOTAL             Backfill denominator fallback (default 383090)
  KG_EXTRACT_INTERVAL          Backfill poll cadence in seconds (default 5)
  SYSMON_INTERVAL              Sysmon poll cadence in seconds (default 3)
  KGOPS_INTERVAL               KG-ops poll cadence in seconds (default 5)
  KGOPS_SSH_HOST               SSH target for kg-extract-poll (default familiar)
  REALM_BENCHMARK_SLATE        Path to the benchmark slate JSON (default
                               ~/.realmwatch/benchmark-slate.json, then the
                               shipped benchmark-slate.example.json fallback)
  BENCHMARK_INTERVAL           Benchmark slate poll cadence in seconds (default 15)

EXAMPLES
  realm wave list                            # see every verb
  realm wave bandwidth                       # run TUI in current terminal
  realm wave install                         # spawn all verbs as Wave blocks
  realm wave install backfill                # spawn just the backfill block
EOF
}

cmd_list() {
    printf '%-12s  %s\n' "VERB" "DESCRIPTION"
    {
        for name in "${!TUIS[@]}"; do
            printf '%-12s  %s\n' "$name" "${SUMMARIES[$name]}"
        done
        for name in "${!MANIFESTS[@]}"; do
            printf '%-12s  %s\n' "$name" "${SUMMARIES[$name]}"
        done
    } | sort -u
}

cmd_run_manifest() {
    # Manifest verb: split the packed mode/interval/cmd and exec
    # wave-block.py directly. Title comes from TITLES[$name].
    local name="$1"
    local packed="${MANIFESTS[$name]}"
    local mode interval cmd
    IFS=$'\x1f' read -r _ mode interval cmd <<< "$packed"
    local title="${TITLES[$name]}"
    local wave_block="$_plugin_dir/blocks/wave-block.py"
    case "$mode" in
        backfill)
            exec "$PY" "$wave_block" backfill --cmd "$cmd" --interval "$interval" ;;
        host)
            exec "$PY" "$wave_block" host --title "$title" --cmd "$cmd" --interval "$interval" ;;
        slate)
            exec "$PY" "$wave_block" slate --title "$title" --cmd "$cmd" --interval "$interval" ;;
        *)
            # Default mode: custom.
            exec "$PY" "$wave_block" custom --title "$title" --cmd "$cmd" --interval "$interval" ;;
    esac
}

cmd_run() {
    local name="$1"; shift || true
    # Manifest-discovered verb?
    if [[ -n "${MANIFESTS[$name]:-}" ]]; then
        cmd_run_manifest "$name"
        return $?
    fi
    # Hardcoded launcher.
    local script="${TUIS[$name]:-}"
    if [[ -z "$script" || ! -f "$script" ]]; then
        echo "realm wave: unknown TUI '$name'. Try: realm wave list" >&2
        return 1
    fi
    exec "$PY" "$script" "$@"
}

# is_fleet_host VERB — return 0 if VERB matches a current_name in fleet.yaml.
# Tries `realm --list-fleet-names` first (5s-cached); falls back to a direct
# yaml parse if the dispatcher isn't reachable.
is_fleet_host() {
    local v="$1"
    [[ -z "$v" ]] && return 1
    local names
    names=$(realm --list-fleet-names 2>/dev/null) || names=""
    if [[ -z "$names" ]]; then
        local fleet="$_repo_dir/fleet.yaml"
        [[ -f "$fleet" ]] || return 1
        names=$("$PY" -c "
import sys, yaml
try:
    d = yaml.safe_load(open('$fleet'))
except Exception:
    sys.exit(0)
nodes = (d or {}).get('nodes') or (d or {}).get('hosts') or (d or {}).get('fleet') or (d if isinstance(d, list) else [])
for n in nodes:
    if not isinstance(n, dict):
        continue
    name = n.get('current_name') or n.get('name') or n.get('id')
    if name:
        print(name)
" 2>/dev/null)
    fi
    [[ -z "$names" ]] && return 1
    while IFS= read -r n; do
        [[ "$n" == "$v" ]] && return 0
    done <<< "$names"
    return 1
}

cmd_run_host() {
    local host="$1"
    local launcher="$_plugin_dir/blocks/host-launcher.py"
    if [[ ! -x "$launcher" ]]; then
        echo "realm wave: host-launcher.py missing or not executable" >&2
        return 1
    fi
    WAVE_HOST="$host" exec "$PY" "$launcher"
}

cmd_install() {
    local target="${1:-}"

    if ! command -v wsh >/dev/null 2>&1; then
        echo "realm wave install: wsh not found on PATH" >&2
        echo "Install Wave Terminal: https://www.waveterm.dev/" >&2
        return 1
    fi
    if [[ -z "${WAVETERM_TABID:-}" ]]; then
        echo "Warning: not inside a Wave terminal block; spawned blocks will" >&2
        echo "land in the current Wave window's active tab." >&2
    fi

    local names
    if [[ -n "$target" ]]; then
        if [[ -z "${TUIS[$target]:-}" && -z "${MANIFESTS[$target]:-}" ]]; then
            echo "realm wave install: unknown TUI '$target'" >&2
            return 1
        fi
        names=("$target")
    else
        # Default spawn order: hardcoded launchers first (they're the
        # historical defaults), then manifest-discovered ones in
        # whatever order discover.py emits.
        names=(daemon palace bandwidth backfill sysmon kgops benchmark)
        for n in "${!MANIFESTS[@]}"; do
            names+=("$n")
        done
    fi

    for n in "${names[@]}"; do
        local cmd="realm wave $n"
        local title="${TITLES[$n]}"
        local out
        out=$(wsh run -c "$cmd" 2>&1) || {
            echo "wsh run failed for $n:" >&2
            echo "  $out" >&2
            continue
        }
        # Output is "run block created: block:<uuid>"
        local id="${out#*block:}"
        id="${id//$'\n'/}"
        if [[ -n "$id" ]]; then
            wsh setmeta -b "$id" "frame:title=$title" >/dev/null 2>&1 || true
            printf '✓ spawned %-12s  block:%s  "%s"\n' "$n" "$id" "$title"
        else
            printf '? %s — could not parse block id from: %s\n' "$n" "$out"
        fi
    done
}

verb="${1:-}"
case "$verb" in
    ""|-h|--help|help)
        usage; exit 0 ;;
    list)
        cmd_list ;;
    install)
        shift; cmd_install "$@" ;;
    *)
        # Hardcoded or manifest-discovered?
        if [[ -n "${TUIS[$verb]:-}" || -n "${MANIFESTS[$verb]:-}" ]]; then
            cmd_run "$verb" "${@:2}"
        elif is_fleet_host "$verb"; then
            # Generic per-host dashboard: GPU/CPU/RAM/disk/temps/net for any
            # Ubuntu host in the fleet. OpenWrt hosts surface as `_error`
            # because they lack python3 by default (see issue #49 for the
            # Phase-B routing that addresses that surface).
            cmd_run_host "$verb"
        else
            echo "realm wave: unknown verb '$verb'" >&2
            echo "Try: realm wave help" >&2
            exit 1
        fi
        ;;
esac
