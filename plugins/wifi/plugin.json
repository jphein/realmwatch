{
  "name": "wifi",
  "version": "1.0.0",
  "type": "integrated",
  "description": "WiFi scanner — SSH to APs, DHCP identity, LLDP topology, AP client lists and signal data.",
  "fantasy_name": "Aether Towers",
  "icon": "\ud83d\udce1",

  "python": {
    "module": "plugin",
    "entry": "setup"
  },

  "panel": {
    "id": "wifi-panel",
    "name": "Aether Towers",
    "html": "panel.html",
    "js": "panel.js",
    "css": "panel.css",
    "anchor": "nw",
    "priority": 16
  },

  "endpoints": [
    {
      "method": "GET",
      "path": "/scan",
      "handler": "handle_scan",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/scan/status",
      "handler": "handle_scan_status",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/scan/lldp",
      "handler": "handle_scan_lldp",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/scan/wifi",
      "handler": "handle_scan_wifi",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/wifi/aps",
      "handler": "handle_wifi_aps",
      "raw_path": true
    }
  ],

  "sse_types": ["wifi"],

  "cli": {
    "summary": "Inspect WiFi APs, clients, and scan state",
    "verbs": [
      {
        "name": "aps",
        "summary": "List APs with their client counts and SSIDs",
        "method": "GET",
        "path": "/wifi/aps",
        "table": "to_entries[] | [.key, (.value.label // \"-\"), (.value.ip // \"-\"), ((.value.clients // []) | length | tostring), ((.value.ssids // []) | map(.ssid) | join(\",\"))]",
        "header": ["AP", "LABEL", "IP", "CLIENTS", "SSIDS"]
      },
      {
        "name": "clients",
        "summary": "Per-AP client list with signal/SNR",
        "method": "GET",
        "path": "/scan/wifi"
      },
      {
        "name": "lldp",
        "summary": "LLDP topology snapshot",
        "method": "GET",
        "path": "/scan/lldp"
      },
      {
        "name": "status",
        "summary": "Current scan job status",
        "method": "GET",
        "path": "/scan/status"
      },
      {
        "name": "scan",
        "summary": "Trigger / refresh a full scan",
        "method": "GET",
        "path": "/scan"
      }
    ]
  },

  "wave": {
    "verb": "wifi",
    "title": "Aether Towers",
    "summary": "Live AP roster — clients per tower, SSID counts",
    "cmd": "realm wifi aps",
    "mode": "custom",
    "interval": 60
  }
}
