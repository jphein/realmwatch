{
  "name": "wifi",
  "version": "1.0.0",
  "type": "integrated",
  "description": "WiFi scanner — SSH to APs, DHCP identity, LLDP topology, AP client lists and signal data.",
  "fantasy_name": "Aether Towers",
  "icon": "\ud83d\udce1",

  "python": {
    "module": "plugin",
    "entry": "setup"
  },

  "panel": {
    "id": "wifi-panel",
    "name": "Aether Towers",
    "html": "panel.html",
    "js": "panel.js",
    "css": "panel.css",
    "anchor": "nw",
    "priority": 16
  },

  "endpoints": [
    {
      "method": "GET",
      "path": "/scan",
      "handler": "handle_scan",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/scan/status",
      "handler": "handle_scan_status",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/scan/lldp",
      "handler": "handle_scan_lldp",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/scan/wifi",
      "handler": "handle_scan_wifi",
      "raw_path": true
    },
    {
      "method": "GET",
      "path": "/wifi/aps",
      "handler": "handle_wifi_aps",
      "raw_path": true
    }
  ],

  "sse_types": ["wifi"]
}
