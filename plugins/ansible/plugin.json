{
  "name": "ansible",
  "version": "1.0.0",
  "type": "integrated",
  "description": "Ansible playbook execution and infrastructure management",
  "fantasy_name": "War Room",
  "icon": "\u2694\ufe0f",

  "python": {
    "module": "plugin",
    "entry": "setup"
  },

  "panel": {
    "id": "ansible-panel",
    "name": "War Room",
    "html": "panel.html",
    "js": "panel.js",
    "css": "panel.css",
    "anchor": "nw",
    "priority": 19
  },

  "endpoints": [
    { "method": "GET",  "path": "inventory",  "handler": "handle_inventory" },
    { "method": "GET",  "path": "playbooks",  "handler": "handle_playbooks" },
    { "method": "POST", "path": "run",        "handler": "handle_run" },
    { "method": "GET",  "path": "runs",       "handler": "handle_runs" },
    { "method": "POST", "path": "ai",         "handler": "handle_ai" }
  ],

  "sse_types": ["ansible"],

  "depends_on": [],

  "config": {
    "playbooks_dir": { "default": "playbooks", "description": "Directory for playbook YAML files" },
    "check_mode_default": { "default": true, "description": "Default to --check (dry run) mode" },
    "openwrt_exclude_kernel": { "default": true, "description": "Exclude kernel packages on OpenWrt upgrades" }
  },

  "cli": {
    "summary": "Ansible playbook execution and infrastructure (War Room)",
    "verbs": [
      {
        "name": "inventory",
        "summary": "Show parsed Ansible inventory",
        "method": "GET",
        "path": "/plugins/ansible/inventory"
      },
      {
        "name": "playbooks",
        "summary": "List available playbooks",
        "method": "GET",
        "path": "/plugins/ansible/playbooks",
        "table": "(.playbooks // .) | .[] | [.name // \"-\", .description // \"-\", (.tags // [] | join(\",\"))]",
        "header": ["NAME", "DESCRIPTION", "TAGS"]
      },
      {
        "name": "runs",
        "summary": "Recent playbook runs",
        "method": "GET",
        "path": "/plugins/ansible/runs",
        "table": "(.runs // .) | .[] | [.id // \"-\", .playbook // \"-\", .status // \"-\", (.started // \"-\"), (.duration // \"-\" | tostring)]",
        "header": ["ID", "PLAYBOOK", "STATUS", "STARTED", "DURATION"]
      },
      {
        "name": "run",
        "summary": "Run a playbook (use --json for full response). Pass --check for dry-run.",
        "method": "POST",
        "path": "/plugins/ansible/run",
        "args": ["playbook"],
        "body": "{\"playbook\":\"$1\"}"
      },
      {
        "name": "ai",
        "summary": "Ask the War Room AI to suggest/explain a playbook",
        "method": "POST",
        "path": "/plugins/ansible/ai",
        "args": ["prompt"],
        "body": "{\"prompt\":\"$1\"}"
      }
    ]
  }
}
