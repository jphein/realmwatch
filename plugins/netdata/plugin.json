{
  "name": "netdata",
  "version": "1.1.0",
  "type": "integrated",
  "description": "Netdata agent discovery — REST API info, charts, alarms, collectors — plus per-host CPU/GPU power draw (watts) surfaced on the map.",
  "fantasy_name": "Oracle Sight",
  "icon": "🕮",
  "python": {"module": "plugin", "entry": "setup"},
  "depends_on": ["discovery"],

  "panel": {
    "id": "host-power-panel",
    "name": "Wattage of the Realm",
    "html": "panel.html",
    "js": "panel.js",
    "css": "panel.css",
    "anchor": "e",
    "priority": 16
  },

  "endpoints": [
    {
      "method": "GET",
      "path": "/host-power",
      "handler": "handle_host_power",
      "raw_path": true
    }
  ],

  "cli": {
    "summary": "Per-host CPU/GPU power draw in watts (Oracle Sight)",
    "verbs": [
      {
        "name": "show",
        "summary": "Live per-host CPU/GPU watts for every host running netdata",
        "method": "GET",
        "path": "/host-power",
        "table": "to_entries | .[] | [(.value.name // .key), ((.value.package_watts // \"-\") | tostring), ((.value.gpu_watts // \"-\") | tostring), (.value.ip // \"-\")]",
        "header": ["HOST", "CPU_W", "GPU_W", "IP"]
      }
    ]
  },

  "discovery_prototypes": [
    {
      "entity_type": "netdata_host",
      "summary": "A host serving the Netdata REST API on :19999",
      "sublabel": "v{{#VERSION}} • {{#CHARTS_COUNT}} charts",
      "fantasy_template": "Seeing Stone at {{#NAME}}",
      "alert_on": [
        {
          "when": "{{#ALARMS_CRITICAL}} > 0",
          "severity": "critical",
          "text_template": "The Seeing Stone at {{#NAME}} reveals {{#ALARMS_CRITICAL}} dire warning(s)"
        },
        {
          "when": "{{#ALARMS_WARNING}} > 5",
          "severity": "warning",
          "text_template": "The Seeing Stone at {{#NAME}} senses {{#ALARMS_WARNING}} disturbances"
        }
      ]
    }
  ]
}
