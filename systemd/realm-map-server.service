# Realm Map Server — HTTP :80 frontend + all background scanners
#
# SYSTEM unit since 2026-08-19 (was a user unit — migrated per the
# system-services-only convention: user units depend on lingering and are
# invisible to `sudo systemctl`, which bit operability every time someone
# looked for this service where services live).
#
# Install: sudo cp systemd/realm-map-server.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now realm-map-server
#   Logs:  sudo journalctl -u realm-map-server -f
#
# :80 binding: AmbientCapabilities grants CAP_NET_BIND_SERVICE to the jp
# process directly, so this unit no longer relies on the host's globally
# lowered net.ipv4.ip_unprivileged_port_start=80 (left in place, but nothing
# here needs it anymore).

[Unit]
Description=Realm Map Server — HTTP :80 for realmwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jp
Group=jp
WorkingDirectory=/home/jp/Projects/realmwatch
EnvironmentFile=/home/jp/Projects/realmwatch/.env
ExecStart=/home/jp/Projects/realmwatch/.venv/bin/python3 map_server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource limits (main server with background scanners)
LimitNOFILE=4096
MemoryHigh=1G
MemoryMax=1536M

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
