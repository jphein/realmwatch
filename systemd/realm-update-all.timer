# Realm Update All — daily timer (03:00 local)
#
# Install:
#   cp systemd/realm-update-all.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now realm-update-all.timer
# Check:
#   systemctl --user list-timers realm-update-all
# Logs:
#   journalctl --user -u realm-update-all -f
#
# Persistent=true means a missed run (laptop closed, host off) fires on next
# boot instead of being silently skipped — important for a desktop-class host
# that isn't 24/7.

[Unit]
Description=Daily realm.watch update orchestration timer
Documentation=https://github.com/jphein/realmwatch

[Timer]
OnCalendar=*-*-* 03:00:00
# Randomize the start within a 15-minute window so multiple realm hosts
# (when JP runs realmwatch on more than one box) don't all pile onto the
# fleet at the exact same second.
RandomizedDelaySec=15min
Persistent=true
Unit=realm-update-all.service

[Install]
WantedBy=timers.target
