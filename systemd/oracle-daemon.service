# Oracle Daemon — AI-powered query responder for the fantasy homelab monitor
# Install: cp systemd/*.service ~/.config/systemd/user/
#          systemctl --user daemon-reload
#          systemctl --user enable oracle-daemon
#          systemctl --user start oracle-daemon
#   Logs:  journalctl --user -u oracle-daemon -f

[Unit]
Description=Oracle Daemon — Azure AI inference for realmwatch
After=network-online.target realm-map-server.service
Wants=network-online.target
Requires=realm-map-server.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/realmwatch
EnvironmentFile=%h/Projects/realmwatch/.env
ExecStart=%h/Projects/realmwatch/.venv/bin/python3 oracle_daemon.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Resource limits (AI inference can use more memory)
MemoryHigh=1G
MemoryMax=1536M

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
