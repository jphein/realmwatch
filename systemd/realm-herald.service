# Realm Herald — TTS voice announcements for the fantasy homelab monitor
# Install: cp systemd/*.service ~/.config/systemd/user/
#          systemctl --user daemon-reload
#          systemctl --user enable realm-herald
#          systemctl --user start realm-herald
#   Logs:  journalctl --user -u realm-herald -f

[Unit]
Description=Realm Herald — Voice announcements for realmwatch
After=network-online.target realm-map-server.service
Wants=network-online.target
Requires=realm-map-server.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/realmwatch
EnvironmentFile=%h/Projects/realmwatch/.env
ExecStart=%h/Projects/realmwatch/venv/bin/python3 realm_herald.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Resource limits
MemoryHigh=512M
MemoryMax=768M

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
